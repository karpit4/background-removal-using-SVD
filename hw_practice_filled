import moviepy.editor as mpe



def video_to_array(video):
    """
    Преобразует видео в 3D-массив:
        (# кадров) x (# пикселей по высоте) x (# пикселей по ширине)

    Используется только первый цветовой канал (grayscale).
    """
    duration = int(video.duration)
    nframes = int(video.fps * video.duration)
    size_w, size_h = video.size

    arr = np.zeros([nframes, size_h, size_w])

    for i in range(nframes):
        arr[i, :, :] = (
            video.get_frame(i / nframes * duration)[:, :, 0].astype(float)
        )

    print(
        "image size: {} x {},\nnumber of frames: {}".format(
            size_w, size_h, nframes
        )
    )

    return arr


def trunc_svd(M, r):
    """
    Вычисляет оптимальное приближение матрицы M рангом r
    и относительную ошибку в фробениусовой норме.

    Parameters
    ----------
    M : np.ndarray
        Двумерная матрица.
    r : int
        Ранг приближения.

    Returns
    -------
    Mr : np.ndarray
        Приближение M ранга r.
    rel_eps : float
        Относительная ошибка:
        ||M - Mr||_F / ||M||_F
    """
    U, S, Vt = np.linalg.svd(M, full_matrices=False)

    Mr = U[:, :r] @ np.diag(S[:r]) @ Vt[:r, :]

    frob_error = np.sqrt(np.sum(S[r:] ** 2) / np.sum(S ** 2))

    return Mr, frob_error


def rand_svd(M, r, oversampling=10):
    """
    Рандомизированное SVD с oversampling.

    Parameters
    ----------
    M : np.ndarray
        Матрица размера m x n.
    r : int
        Требуемый ранг.
    oversampling : int
        Число дополнительных случайных направлений.

    Returns
    -------
    U : np.ndarray
    s : np.ndarray
    Vt : np.ndarray
        Компактное приближение SVD ранга r.
    """
    _, n = M.shape
    l = r + oversampling

    # Шаг 1: Randomized Range Finder
    Omega = np.random.randn(n, l)
    Y = M @ Omega
    Q, _ = np.linalg.qr(Y)

    # Шаг 2: SVD малой матрицы
    B = Q.T @ M
    U_tilde, s, Vt = np.linalg.svd(B, full_matrices=False)

    # Восстанавливаем левые сингулярные векторы
    U = Q @ U_tilde

    # Возвращаем только r компонент
    return U[:, :r], s[:r], Vt[:r, :]


def M_to_video(M, fps, size_w, size_h):
    """
    Преобразует матрицу M формата
        (size_h * size_w) x nframes
    обратно в grayscale-видео.
    """
    nframes = M.shape[1]
    arr = M.T.reshape(nframes, size_h, size_w)

    def make_frame(t):
        index = int(t * fps)

        # Защита от выхода за последний индекс кадра
        index = min(index, nframes - 1)

        frame = arr[index, :, :]
        frame = np.clip(frame, 0, 255)

        # grayscale -> RGB
        frame_rgb = frame[:, :, np.newaxis][:, :, [0, 0, 0]]

        return frame_rgb

    return mpe.VideoClip(make_frame, duration=nframes / fps)


def project_new_frames(U, S, VT, new_frames):
    """
    Ортогонально проецирует новые кадры на образ матрицы M2_r.

    Parameters
    ----------
    U, S, VT :
        Rank-r компактное SVD-разложение.
        S и VT явно не нужны для самой проекции, но принимаются
        для совместимости с SVD API.
    new_frames :
        Вектор размера (size_h * size_w,)
        или матрица размера (size_h * size_w) x k.

    Returns
    -------
    proj :
        Проекция новых кадров на Im(U).
    """
    # Проекция:
    # proj = U @ (U^T @ new_frames)
    coords = U.T @ new_frames
    proj = U @ coords

    return proj


